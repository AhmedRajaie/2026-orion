import glob

UNIVERSE = ['COMI', 'HRHO', 'TMGH', 'SWDY', 'FWRY', 'ABUK']  # same 6 stocks as Notebook 4
START_CAPITAL = 1000.0
per_stock_seed = START_CAPITAL / len(UNIVERSE)

def run_universe_weekly_threshold(symbols, data_dir="data/egx", start_cash=100.0):
    equity_frames = []
    for sym in symbols:
        stock_df = load_egx_stock(f"{data_dir}/{sym}.csv")
        bt = backtest_weekly_threshold(stock_df, start_cash=start_cash)
        eq = bt.set_index("date")["equity"].rename(sym)
        equity_frames.append(eq)

    universe_equity = pd.concat(equity_frames, axis=1, sort=True).sort_index().ffill()
    portfolio_equity = universe_equity.sum(axis=1)
    return universe_equity, portfolio_equity

universe_equity, portfolio_equity = run_universe_weekly_threshold(UNIVERSE, start_cash=per_stock_seed)

portfolio_returns = portfolio_equity.pct_change().dropna()
new_total_return = total_return(portfolio_returns)
new_max_dd = max_drawdown(portfolio_returns)
new_final_value = portfolio_equity.iloc[-1]

print("New strategy — weekly threshold, same 6-stock universe as Notebook 4")
print(f" total_return : {new_total_return:+.1%}")
print(f" max_drawdown : {new_max_dd:.1%}")
print(f" final value  : {new_final_value:.2f} EGP  (started at {START_CAPITAL:.0f} EGP)")